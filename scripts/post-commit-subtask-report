#!/usr/bin/env bash
# Optional git post-commit hook: fires scripts/subtask-report.sh automatically the moment a
# commit closes a sub-task boundary — reusing .kilo/plugins/subtask-gate.ts's own definition
# (a commit touching wiki/handoffs/SESSION_PRIMER.md), not a second invented one. Every other
# commit is a no-op here (silent, no output) so routine per-file commits stay quiet.
#
# A post-commit hook physically cannot block or roll back the commit that already landed — this
# script additionally never lets a check's own failure crash the shell it runs in (subtask-
# report.sh itself already treats every check as best-effort; this wrapper is a second layer of
# the same guarantee for the hook invocation itself).
#
# Install:
#   cp scripts/post-commit-subtask-report .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit
#
# Run the same report by hand any time (no hook needed):
#   scripts/subtask-report.sh

set +e
cd "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || exit 0

# --root: without it, git diff-tree prints nothing at all for the repo's very first (root)
# commit -- confirmed live, a real bug caught by this hook's own test (T8) -- which would make a
# fresh repo's first commit (very plausibly the one that also seeds SESSION_PRIMER.md) silently
# never fire the report.
TOUCHED="$(git diff-tree --no-commit-id --name-only -r --root HEAD 2>/dev/null)"
if ! printf '%s\n' "$TOUCHED" | grep -qx 'wiki/handoffs/SESSION_PRIMER.md'; then
  exit 0 # not a sub-task-closing commit — stay quiet
fi

if [ ! -x scripts/subtask-report.sh ]; then
  echo "post-commit-subtask-report: 보고서 생성 실패 — scripts/subtask-report.sh missing or not executable (commit still landed; this hook never blocks)" >&2
  exit 0
fi

SHORT="$(git rev-parse --short HEAD 2>/dev/null)"
mkdir -p .subtask-reports 2>/dev/null

echo ""
echo "================ subtask-report (auto, HEAD touched SESSION_PRIMER.md) ================"
# round 35 item 4: this hook always exits 0 by design (a post-commit hook physically cannot
# undo the commit) -- correct for not blocking, but it used to mean subtask-report.sh crashing
# outright (not just one of its own checks failing, which it already tolerates) went completely
# silent: report generation just quietly stopped happening, forever, with nothing on record
# anywhere. PIPESTATUS reads scripts/subtask-report.sh's own exit code THROUGH the tee (tee's
# own exit status, which is what a bare `$?` after the pipe would give, only reflects tee).
if [ -n "$SHORT" ] && [ -d .subtask-reports ]; then
  scripts/subtask-report.sh 2>&1 | tee ".subtask-reports/${SHORT}.md"
  gen_rc="${PIPESTATUS[0]}"
else
  scripts/subtask-report.sh 2>&1
  gen_rc=$?
fi
echo "=========================================================================================="
if [ "$gen_rc" -ne 0 ]; then
  echo "post-commit-subtask-report: 보고서 생성 실패 — scripts/subtask-report.sh exited $gen_rc (see output above; commit still landed, this hook never blocks)" >&2
fi

# layer 2 (local-model diff review) — optional and best-effort in the exact same sense as layer 1:
# never blocks, never lets its own crash go silent. A missing/non-executable script here is not
# an error the way a missing layer 1 would be (layer 2 is a newer, lower-trust addition, see its
# own header) -- skip quietly if it's not present, e.g. an older checkout of this template.
if [ -x scripts/subtask-review-llm.sh ]; then
  echo ""
  echo "================ subtask-review-llm (auto, layer 2) ===================================="
  if [ -n "$SHORT" ] && [ -d .subtask-reports ]; then
    scripts/subtask-review-llm.sh 2>&1 | tee -a ".subtask-reports/${SHORT}.md"
    gen2_rc="${PIPESTATUS[0]}"
  else
    scripts/subtask-review-llm.sh 2>&1
    gen2_rc=$?
  fi
  echo "=========================================================================================="
  if [ "$gen2_rc" -ne 0 ]; then
    echo "post-commit-subtask-report: 보고서 생성 실패(layer 2) — scripts/subtask-review-llm.sh exited $gen2_rc (see output above; commit still landed, this hook never blocks)" >&2
  fi
fi

exit 0
